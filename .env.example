APP_NAME="KARTEKS ENERGY SOLUTION"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://karteks-energy-solution.test

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=karteks_energy_solution
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="karteksenergy27@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================
# KARTEKS BUSINESS CONFIG
# =============================================================

# Company
COMPANY_NAME="KARTEKS ENERGY SOLUTION"
COMPANY_EMAIL="karteksenergy27@gmail.com"
COMPANY_PHONE="+6281545326426"
COMPANY_WHATSAPP="+6281545326426"
COMPANY_WEBSITE="https://www.karteksenergy.com"
COMPANY_ADDRESS="Jln. Bonto Marannu, Perumahan Tanjung Kencana Residence No. 8, Kabupaten Gowa, Sulawesi Selatan, Indonesia"

# Default Currency & Locale
DEFAULT_CURRENCY=IDR
DEFAULT_TIMEZONE="Asia/Makassar"

# Midtrans Payment Gateway
# Daftar di https://midtrans.com untuk mendapatkan sandbox keys.
# Server key SB-Mid-server-XXXXX, Client key SB-Mid-client-XXXXX.
MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_NOTIFICATION_URL="${APP_URL}/api/v1/payments/midtrans/notification"
MIDTRANS_FINISH_URL="${APP_URL}/payment/finish"
MIDTRANS_UNFINISH_URL="${APP_URL}/payment/unfinish"
MIDTRANS_ERROR_URL="${APP_URL}/payment/error"

# WhatsApp Business Number
WHATSAPP_BUSINESS_NUMBER="+6281545326426"

# Firebase Cloud Messaging (untuk Flutter push notification - opsional tahap awal)
FCM_SERVER_KEY=
FCM_PROJECT_ID=

VITE_APP_NAME="${APP_NAME}"
