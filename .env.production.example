# =============================================================================
# KARTEKS Energy Solution — Production Environment Template
# =============================================================================
# Copy this file to .env on your production server:
#   cp .env.production.example .env
#
# IMPORTANT: NEVER commit .env to version control!
# =============================================================================

APP_NAME="KARTEKS ENERGY SOLUTION"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.karteksenergy.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# =============================================
# DATABASE (MySQL)
# =============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=karteks_energy_solution
DB_USERNAME=karteks_user
DB_PASSWORD=STRONG_PASSWORD_HERE

# =============================================
# SESSION & CACHE
# =============================================
# For production: use Redis for both
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=karteks_

# Redis config (required if using redis for queue/session/cache)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================
# QUEUE
# =============================================
# Use 'redis' for production with multiple workers
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis

# =============================================
# MAIL (configure SMTP for production)
# =============================================
# Example: Postmark, Mailgun, Resend, AWS SES, etc.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.postmarkapp.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@karteksenergy.com"
MAIL_FROM_NAME="KARTEKS ENERGY SOLUTION"

# =============================================
# FILE STORAGE
# =============================================
FILESYSTEM_DISK=local
# For S3: set FILESYSTEM_DISK=s3 and configure AWS_* vars below
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=karteks-media
# AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================
# KARTEKS BUSINESS CONFIG
# =============================================
COMPANY_NAME="KARTEKS ENERGY SOLUTION"
COMPANY_EMAIL="karteksenergy27@gmail.com"
COMPANY_PHONE="+6281545326426"
COMPANY_WHATSAPP="+6281545326426"
COMPANY_WEBSITE="https://www.karteksenergy.com"
COMPANY_ADDRESS="Jln. Bonto Marannu, Perumahan Tanjung Kencana Residence No. 8, Kabupaten Gowa, Sulawesi Selatan, Indonesia"

DEFAULT_CURRENCY=IDR
DEFAULT_TIMEZONE="Asia/Makassar"

# =============================================
# MIDTRANS PAYMENT GATEWAY (REQUIRED)
# =============================================
# Production keys from: https://dashboard.midtrans.com
MIDTRANS_ENV=production
MIDTRANS_SERVER_KEY=your_production_server_key
MIDTRANS_CLIENT_KEY=your_production_client_key
MIDTRANS_MERCHANT_ID=your_merchant_id
MIDTRANS_NOTIFICATION_URL="${APP_URL}/api/v1/payments/midtrans/notification"
MIDTRANS_FINISH_URL="${APP_URL}/payment/finish"
MIDTRANS_UNFINISH_URL="${APP_URL}/payment/unfinish"
MIDTRANS_ERROR_URL="${APP_URL}/payment/error"

# =============================================
# SHIPPING
# =============================================
SHIPPING_PROVIDER=manual
# For live rates: SHIPPING_PROVIDER=rajaongkir
# RAJAONGKIR_API_KEY=your_key
# RAJAONGKIR_PACKAGE=starter
# Free shipping threshold (empty = disabled):
FREE_SHIPPING_THRESHOLD=
SHIPPING_ORIGIN_CITY=Gowa

# =============================================
# WHATSAPP
# =============================================
WHATSAPP_BUSINESS_NUMBER="+6281545326426"
WHATSAPP_PROVIDER=fonnte
WHATSAPP_API_TOKEN=your_fonnte_token
WHATSAPP_API_URL=https://api.fonnte.com
WHATSAPP_ENABLED=true

# =============================================
# FIREBASE CLOUD MESSAGING (Flutter)
# =============================================
FCM_SERVER_KEY=
FCM_PROJECT_ID=

CART_TAX_RATE=0

VITE_APP_NAME="${APP_NAME}"
